#!/usr/bin/env bash
# Enforces commit message conventions for humans and agents.
#   - conventional subject: type(scope): summary (merge commits exempt)
#   - Co-Authored-By trailer for agent commits
#   - Work-Package trailer on branches other than main
set -euo pipefail

msg_file="$1"
subject="$(head -n1 "$msg_file")"

if [[ "$subject" =~ ^Merge\  ]] || [[ "$subject" =~ ^(fixup|squash)! ]]; then
    exit 0
fi

if ! [[ "$subject" =~ ^(feat|fix|test|refactor|perf|docs|chore|build|ci|style)(\([a-z0-9_,./-]+\))?!?:\ .{1,100}$ ]]; then
    echo "commit-msg: subject must look like 'feat(a3s_sync): summary' (got: $subject)" >&2
    exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
if [[ "$branch" != "main" && "$branch" != "HEAD" ]]; then
    if ! grep -q '^Work-Package: ' "$msg_file"; then
        echo "commit-msg: branch '$branch' requires a 'Work-Package: <id>' trailer" >&2
        exit 1
    fi
    if ! grep -q '^Co-Authored-By: ' "$msg_file"; then
        echo "commit-msg: agent commits require a Co-Authored-By trailer" >&2
        exit 1
    fi
fi
exit 0
