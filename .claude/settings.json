{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CARGO_BUILD_JOBS": "8",
    "CARGO_TERM_COLOR": "never"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/gate.sh:*)",
      "Bash(./scripts/gate.sh:*)",
      "Bash(/run/media/system/Main_storage/Projects/arma_3_sync_rs/scripts/gate.sh:*)",
      "Bash(/run/media/system/Main_storage/Projects/arma_3_sync_rs/.claude/worktrees/:*)",
      "Bash(python3 scripts/scope_check.py:*)",
      "Bash(python3 /run/media/system/Main_storage/Projects/arma_3_sync_rs/scripts/scope_check.py:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(typos:*)",
      "Bash(cargo search:*)",
      "Bash(cargo info:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git checkout --ours:*)",
      "Bash(git checkout --theirs:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git -C:*)",
      "Read(//run/media/system/Main_storage/Projects/arma_3_sync_rs/**)",
      "Edit(crates/**)",
      "Write(crates/**)",
      "Edit(docs/specs/**)",
      "Write(docs/specs/**)",
      "Edit(.claude/worktrees/**)",
      "Write(.claude/worktrees/**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(cargo install:*)",
      "Edit(java_version/**)",
      "Write(java_version/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_paths.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject_progress.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_agent.py"
          }
        ]
      }
    ]
  }
}
